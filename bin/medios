#!/usr/bin/env bash
set -uo pipefail

CONF="${MEDIA_BRIDGE_CONFIG:-$HOME/.config/media-bridge/config}"
SHARE="${MEDIA_BRIDGE_SHARE:-$HOME/.local/share/media-bridge}"
COMANDOS=(on off estado progreso reescanear buscar comprobar logs actualizar version ayuda)
TEMAS=(config problemas)

ayuda() {
  cat <<EOF
Uso: medios <comando>

  on [-j]             monta las carpetas, arranca el DLNA y los reenvíos (-j: QR de Jellyfin)
  off                 lo apaga todo
  estado [-j]         qué está encendido, en qué direcciones y qué aparatos lo han encontrado
  progreso            cuántos vídeos lleva indexados el DLNA, en directo
  reescanear          busca vídeos nuevos en el DLNA ahora mismo
  buscar "texto"      busca una película o serie sin acertar el nombre exacto
  comprobar           revisa la red, el servidor, las carpetas y los puertos sin encender nada
  logs [qué] [-f]     los registros: montaje, dlna, reenvios, reescaneo o descubrimiento (-f: en directo)
  actualizar          baja la última versión y la instala, sin tocar la configuración
  version             la versión instalada
  ayuda [comando]     esta ayuda, o más detalle de un comando (también -h y --help)

Configuración: $CONF
Más detalle de un comando: medios ayuda <comando> o medios <comando> -h
Qué es cada opción de la configuración y qué valor tiene: medios ayuda config
Si algo no funciona: medios ayuda problemas
Todo junto: man medios
EOF
}

uso() {
  echo "Uso: medios on | off | estado | progreso | reescanear | buscar \"texto\" | comprobar | logs | actualizar | version | ayuda"
  echo "Qué hace cada uno: medios -h"
  exit 1
}

sugerir() {
  local parecida
  parecida=$(python3 -c '
import difflib, sys
m = difflib.get_close_matches(sys.argv[1].lower(), sys.argv[2:], 1, 0.6)
print(m[0] if m else "")' "$@" 2>/dev/null)
  if [ -n "$parecida" ]; then
    printf ' ¿Querías decir "%s"?' "$parecida"
  fi
}

no_conozco() {
  local que=$1 palabra=$2
  shift 2
  echo "No conozco $que \"$palabra\".$(sugerir "$palabra" "$@")"
}

variables_config() {
  cat <<'EOF'
SERVIDOR|-|IP de Tailscale del servidor (tailscale ip -4 en él). Obligatoria.
USUARIO_SSH|-|Usuario con el que se entra al servidor por SSH. Obligatoria.
RUTA_MEDIOS|-|Carpeta del servidor donde están los vídeos. Obligatoria.
CARPETAS|-|Subcarpetas de RUTA_MEDIOS que se publican por DLNA y en las que busca medios buscar, por ejemplo ("Movies" "Tv Shows"). Obligatoria. Cambiarlas hace que el DLNA indexe todo de nuevo.
REENVIOS||Puertos del servidor que se reenvían a la red local, separados por espacios, por ejemplo "8096" para Jellyfin. Vacío para ninguno.
DLNA|si|Publicar CARPETAS por DLNA para la televisión (si o no).
NOMBRE_DLNA|media-bridge|Nombre con el que aparece el DLNA en la televisión.
PUERTO_DLNA|8200|Puerto del DLNA.
PUERTO_JELLYFIN|8096|Cuál de los REENVIOS es Jellyfin, para el QR de -j y el descubrimiento.
DESCUBRIMIENTO_JELLYFIN|si|Contestar a las apps de Jellyfin de la red local para que encuentren el servidor solas (si o no). Solo funciona si PUERTO_JELLYFIN está en REENVIOS.
INTERFAZ||Interfaz de la red local, por ejemplo wlan0. Vacío para usar la de la ruta por defecto.
PUNTO_MONTAJE|~/media-bridge|Dónde se montan las carpetas del servidor.
DB_DLNA|~/.cache/media-bridge|Dónde guarda el DLNA su índice, y las fechas de Añadidos recientemente.
EXTENSIONES|mkv mp4 avi m4v mov wmv mpg mpeg ts webm|Extensiones que cuentan como vídeo.
REESCANEO_SEGUNDOS|3600|Cada cuántos segundos mira si hay vídeos nuevos o borrados. 0 lo desactiva.
REENVIOS_SOLO_LAN|no|Con si, los reenvíos escuchan solo en la IP de la red local, no en Tailscale ni en otras interfaces.
CLAVE_SSH||Clave SSH concreta para entrar al servidor. Vacío usa las de siempre.
RECIENTES|no|Añadir al DLNA la carpeta "Añadidos recientemente" (si o no). Activarla o quitarla hace que el DLNA indexe todo de nuevo.
RECIENTES_CANTIDAD|10|Cuántos vídeos enseña Añadidos recientemente.
RECIENTES_CARPETAS||De qué CARPETAS salen los recientes, por ejemplo ("Movies") para dejar fuera las series. Vacío para todas.
EOF
}

valor_config() {
  local declaracion
  declaracion=$(declare -p "$1" 2>/dev/null) || return 1
  if [[ "$declaracion" == "declare -a"* ]]; then
    local -n lista=$1
    local e texto=""
    for e in "${lista[@]}"; do
      texto+="${texto:+ }\"$e\""
    done
    printf '(%s)' "$texto"
  else
    printf '%s' "${!1}"
  fi
}

ayuda_config() {
  local modo=${1:-terminal} nombre defecto texto actual marca
  if [ "$modo" = terminal ]; then
    echo "medios ayuda config"
    if [ -f "$CONF" ]; then
      echo "  Tu configuración está en $CONF y tiene estos valores."
    else
      echo "  Todavía no hay configuración en $CONF. Cópiala desde config.example; estos son los valores por defecto."
    fi
  fi
  echo "  Es un fichero de bash: cada línea es NOMBRE=valor, y CARPETAS y RECIENTES_CARPETAS son listas"
  echo "  entre paréntesis. En Docker van en media-bridge.env, con las listas separadas por comas."
  echo "  Los cambios se aplican con medios off y medios on."
  [ "$modo" = terminal ] && echo
  while IFS='|' read -r nombre defecto texto; do
    if [ "$modo" = manual ]; then
      echo "$nombre"
      case "$defecto" in
        -) echo "  $texto" ;;
        "") echo "  $texto Por defecto, vacío." ;;
        *) echo "  $texto Por defecto: $defecto." ;;
      esac
      continue
    fi
    defecto=${defecto/#\~/$HOME}
    marca=""
    # shellcheck source=/dev/null
    if [ -f "$CONF" ] && actual=$(set +u; source "$CONF" >/dev/null 2>&1; valor_config "$nombre"); then
      if [ "$defecto" != - ] && [ "$actual" != "$defecto" ]; then
        marca="  (por defecto: ${defecto:-vacío})"
      fi
    elif [ "$defecto" = - ]; then
      actual="¡falta!"
    else
      actual=$defecto
      [ -f "$CONF" ] && marca="  (por defecto)"
    fi
    [ -z "$actual" ] && actual='""'
    echo "$nombre = $actual$marca"
    echo "$texto" | fold -s -w 88 | sed -e 's/ *$//' -e 's/^/  /'
  done < <(variables_config)
}

ayuda_problemas() {
  cat <<'EOF'
medios ayuda problemas
  Lo primero, siempre: medios comprobar. Revisa la red, el SSH, las carpetas y los puertos y dice
  qué falla. Los registros de cada parte se ven con medios logs (medios logs dlna, medios logs montaje...).

La televisión no encuentra el DLNA
  - Tiene que estar en la misma red que este equipo, y esa red no puede aislar a los aparatos
    entre sí, como hacen muchas Wi-Fi de invitados y de hoteles.
  - medios estado dice qué aparatos lo han encontrado. Si la televisión no sale, no le llegan
    los anuncios del DLNA.
  - Con ufw activo hacen falta abiertos PUERTO_DLNA (8200) y 1900/udp: ./install.sh --firewall
  - Si en casa y fuera se usa la misma numeración de red (por ejemplo, las dos 192.168.1.x),
    la respuesta sale por Tailscale: sudo tailscale set --accept-routes=false
  - Sal de la fuente y vuelve a entrar, o apaga y enciende la televisión: algunas solo buscan
    servidores al arrancar.

El DLNA sale vacío o faltan vídeos
  - Si está indexando, los vídeos van apareciendo poco a poco: medios progreso
  - Los vídeos nuevos entran en el siguiente reescaneo (cada REESCANEO_SEGUNDOS) o ya mismo con
    medios reescanear, que corta lo que se esté viendo.
  - Solo cuentan los ficheros con las extensiones de EXTENSIONES.
  - medios buscar "texto" dice si el vídeo está en el servidor.

Indexa todo de nuevo al encender
  - Pasa una vez al cambiar CARPETAS o RECIENTES, y medios on lo avisa. Mientras dura, la
    televisión puede decir "no compatible" en lo que tenías abierto: vuelve a entrar en el servidor.

Un vídeo no se reproduce o se corta
  - El DLNA no convierte nada: si la televisión no entiende el formato (algunos AVI, ciertos
    audios), ese vídeo no se verá. Usa Jellyfin con el reenvío, que sí convierte.
  - Si se corta, mira si Tailscale va directo: tailscale ping SERVIDOR tiene que decir "via" con
    una IP, no "via DERP", que es un relé lento.
  - Una Wi-Fi de 2,4 GHz o con poca señal también corta: mejor 5 GHz o cable.
  - Los vídeos que están en montajes en la nube (rclone) tardan más en arrancar.

Una película sale con otro nombre
  - Algunos .mp4 llevan un título interno y el DLNA enseña ese en lugar del nombre del fichero.

La app de Jellyfin no encuentra el servidor o no conecta
  - PUERTO_JELLYFIN tiene que estar en REENVIOS. medios estado -j da la dirección y un QR.
  - medios comprobar avisa si el servidor no responde en ese puerto: Jellyfin tiene que estar
    encendido y escuchar en Tailscale.
  - Para que la app lo encuentre sola hacen falta DESCUBRIMIENTO_JELLYFIN=si y, con ufw, el
    7359/udp abierto.
  - Si Jellyfin baja la calidad porque lo considera remoto, añade 100.64.0.0/10 a sus redes LAN.

No entra al servidor por SSH
  - tailscale status tiene que mostrar el servidor conectado.
  - Entra a mano una vez para aceptar su huella: ssh USUARIO_SSH@SERVIDOR. Si dice "Host key
    verification failed", la huella ha cambiado; bórrala con ssh-keygen -R SERVIDOR y vuelve a entrar.
  - Los servicios no pueden escribir contraseñas: hace falta una clave SSH sin contraseña
    (ssh-copy-id USUARIO_SSH@SERVIDOR) o CLAVE_SSH.

Las carpetas no responden ("Transport endpoint is not connected")
  - El montaje se ha quedado colgado, normalmente al perder la red: medios off y medios on.
  - Si sigue igual: fusermount3 -uz PUNTO_MONTAJE y medios on otra vez.

El puerto 8200 está ocupado
  - Suele ser el minidlna del sistema: sudo systemctl disable --now minidlna.service

Después de actualizar todo sigue igual
  - Lo que estaba encendido sigue con la versión anterior hasta medios off y medios on.
EOF
}

ayuda_comando() {
  case "$1" in
    on)
      echo "medios on"
      echo "  Antes de arrancar comprueba la red local, que no salga por Tailscale, el SSH al servidor,"
      echo "  las carpetas y los puertos. Si algo falla (✘) no enciende nada; medios on --forzar se lo salta."
      echo "  También avisa (!) si ufw no abre los puertos o si va a reindexar todo por cambiar CARPETAS."
      echo "  Las mismas comprobaciones, sin encender nada: medios comprobar."
      echo "  Después monta las carpetas del servidor por sshfs, arranca el DLNA con el reescaneo"
      echo "  automático y reenvía los puertos de REENVIOS. Termina enseñando el estado."
      echo "  Con REENVIOS_SOLO_LAN=si los reenvíos escuchan solo en la IP de la red local, no en"
      echo "  Tailscale ni en otras interfaces, y se mueven solos si esa IP cambia."
      echo "  Con -j o --jellyfin enseña además un código QR con la dirección de Jellyfin,"
      echo "  para abrirla en el móvil. Se pueden juntar: medios on --forzar -j."
      echo "  Si PUERTO_JELLYFIN está en REENVIOS, contesta además al descubrimiento de las apps de Jellyfin"
      echo "  (7359/udp), para que encuentren el servidor solas sin escribir la dirección."
      echo "  DESCUBRIMIENTO_JELLYFIN=no lo desactiva."
      echo "  Con RECIENTES=si añade al DLNA la carpeta \"Añadidos recientemente\" con los"
      echo "  RECIENTES_CANTIDAD últimos vídeos (10 por defecto) de RECIENTES_CARPETAS, numerados del más nuevo"
      echo "  al más antiguo. Se rehace cada vez que el reescaneo encuentra cambios."
      echo "  La primera vez, si falta qrencode, lo descarga e instala (pide la contraseña de sudo)."
      echo "  En Docker no se usa: se enciende con docker compose up -d."
      ;;
    off)
      echo "medios off"
      echo "  Para todos los servicios media-bridge-* y desmonta las carpetas."
      echo "  El índice del DLNA se conserva. En Docker se apaga con docker compose down."
      ;;
    estado)
      echo "medios estado"
      echo "  Lista los servicios, las direcciones de los reenvíos en la red local,"
      echo "  el nombre del DLNA, cada cuánto se busca si hay vídeos nuevos y qué aparatos"
      echo "  (televisiones, móviles) han encontrado el DLNA y cuáles están conectados ahora."
      echo "  Con -j o --jellyfin enseña además el QR con la dirección de Jellyfin."
      echo "  Es lo que hace medios sin ningún comando."
      ;;
    progreso)
      echo "medios progreso"
      echo "  Cuenta en directo los vídeos que lleva indexados el DLNA frente a los que hay"
      echo "  en el servidor, con el ritmo por minuto y el tiempo que falta. Ctrl+C para salir."
      ;;
    reescanear)
      echo "medios reescanear"
      echo "  Reinicia el DLNA para que busque vídeos nuevos o borrados ya, sin esperar."
      echo "  Corta lo que se esté viendo en la televisión."
      echo "  Sin él, se reescanea solo cada REESCANEO_SEGUNDOS si hay cambios y nadie está viendo nada."
      ;;
    buscar)
      echo "medios buscar \"texto\""
      echo "  Busca en las CARPETAS del servidor por SSH, aunque el DLNA esté apagado."
      echo "  No distingue mayúsculas, tildes ni separadores, acepta las palabras"
      echo "  en cualquier orden y tolera erratas."
      ;;
    comprobar)
      echo "medios comprobar"
      echo "  Hace las mismas comprobaciones que medios on, pero sin encender ni apagar nada: que hay"
      echo "  red local y no sale por Tailscale, que entra al servidor por SSH, que existen las carpetas,"
      echo "  que los puertos están libres o ya son de media-bridge y que ufw los abre."
      echo "  Lo marcado con ✘ impediría encender; lo marcado con ! es solo un aviso. Devuelve 1 si hay algún ✘."
      echo "  Se puede usar con todo encendido. En Docker: docker compose exec media-bridge medios comprobar"
      ;;
    actualizar)
      echo "medios actualizar"
      echo "  Hace git pull en el clon desde el que se instaló y vuelve a ejecutar install.sh."
      echo "  Conserva la configuración y no reinicia nada: lo encendido sigue con la versión"
      echo "  anterior hasta medios off y medios on. En Docker se reconstruye la imagen."
      ;;
    logs)
      echo "medios logs [montaje|dlna|reenvios|reescaneo|descubrimiento] [-f]"
      echo "  Enseña las últimas 50 líneas de los registros de media-bridge, de todo o de una parte."
      echo "  Con -f se queda mostrando lo que va pasando (Ctrl+C para salir)."
      echo "  En Docker los registros se ven con docker compose logs -f."
      ;;
    version)
      echo "medios version"
      echo "  Muestra la versión instalada."
      ;;
    ayuda|-h|--help)
      echo "medios ayuda [comando]"
      echo "  Sin comando, la lista de comandos. Con uno, su detalle."
      echo "  medios -h, medios --help y medios <comando> -h hacen lo mismo."
      echo "  medios ayuda config explica cada opción de la configuración con el valor que tiene."
      echo "  medios ayuda problemas reúne lo que suele fallar y cómo arreglarlo."
      echo "  man medios lo junta todo en una página de manual."
      ;;
    config)
      ayuda_config
      ;;
    problemas)
      ayuda_problemas
      ;;
    *)
      no_conozco "el comando" "$1" "${COMANDOS[@]}" "${TEMAS[@]}"
      echo
      ayuda
      exit 1
      ;;
  esac
}

a_man() {
  sed -e 's/\\/\\e/g' -e 's/-/\\-/g' -e "s/^\( *\)\([.']\)/\1\\\\\&\2/" -e '/^$/d' \
    -e 's/^\([^ ]\)/.SS \1/' -e 's/^ *\\- /.IP \\(bu 2\n/' -e 's/^ *//'
}

manual() {
  local version c
  version=$(cat "$SHARE/VERSION" 2>/dev/null || echo desconocida)
  cat <<EOF
.TH MEDIOS 1 "" "media-bridge $version" "Manual de media-bridge"
.SH NOMBRE
medios \\- puente para ver en una televisión ajena los vídeos de tu servidor
.SH SINOPSIS
.B medios
.RI [ comando ]
.RI [ opciones ]
.SH DESCRIPCIÓN
Monta por SSH las carpetas de vídeos de un servidor al que se llega por Tailscale,
las publica por DLNA en la red local y reenvía puertos como el de Jellyfin,
para verlos en una televisión que no está en tu red.
Sin comando, hace lo mismo que
.BR "medios estado" .
.SH COMANDOS
EOF
  for c in "${COMANDOS[@]}"; do
    ayuda_comando "$c" | a_man
  done
  echo ".SH CONFIGURACIÓN"
  echo "Está en ~/.config/media-bridge/config, o en el fichero de la variable MEDIA_BRIDGE_CONFIG."
  echo ".PP"
  ayuda_config manual | a_man
  echo ".SH PROBLEMAS"
  ayuda_problemas | tail -n +2 | a_man
  cat <<EOF
.SH ARCHIVOS
.TP
~/.config/media-bridge/config
La configuración.
.TP
~/.cache/media-bridge
El índice del DLNA y las fechas de Añadidos recientemente (DB_DLNA).
.TP
~/.config/systemd/user/media\\-bridge\\-*
Los servicios de systemd que encienden medios on y apagan medios off.
.SH VÉASE TAMBIÉN
.BR minidlnad (8),
.BR sshfs (1),
.BR tailscale (1)
.PP
https://github.com/Pacorbemo/media\\-bridge
EOF
}

case "${2:-}" in
  -h|--help)
    ayuda_comando "$1"
    exit 0
    ;;
esac

case "${1:-}" in
  -h|--help|ayuda)
    if [ -n "${2:-}" ]; then
      ayuda_comando "$2"
    else
      ayuda
    fi
    exit 0
    ;;
  _manual)
    manual
    exit 0
    ;;
  version)
    cat "$SHARE/VERSION" 2>/dev/null || echo "desconocida"
    exit 0
    ;;
  actualizar)
    if [ "${MEDIA_BRIDGE_DOCKER:-}" = 1 ]; then
      echo "En Docker se actualiza desde el clon del repo con: git pull && docker compose up -d --build"
      exit 1
    fi
    clon=$(cat "$SHARE/clon" 2>/dev/null)
    if [ -z "$clon" ] || [ ! -e "$clon/.git" ]; then
      echo "No encuentro el clon del repo desde el que se instaló."
      echo "Para actualizar, clónalo de nuevo e instálalo otra vez (tu configuración se mantiene):"
      echo "  git clone https://github.com/Pacorbemo/media-bridge.git"
      echo "  cd media-bridge && ./install.sh"
      exit 1
    fi
    if ! command -v git >/dev/null; then
      echo "Hace falta git para actualizar"
      exit 1
    fi
    antes=$(cat "$SHARE/VERSION" 2>/dev/null)
    echo "Actualizando desde $clon"
    if ! git -C "$clon" pull --ff-only; then
      echo "No se pudo bajar la última versión. Revisa el clon con: git -C \"$clon\" status"
      exit 1
    fi
    "$clon/install.sh" || exit 1
    echo "Versión: ${antes:-desconocida} → $(cat "$SHARE/VERSION" 2>/dev/null)"
    if systemctl --user list-units --state=active --plain --no-legend 'media-bridge-*' | grep -q .; then
      echo "Lo que está encendido sigue con la versión anterior hasta que hagas: medios off && medios on"
    fi
    exit 0
    ;;
esac

case "${1:-estado}" in
  on|off|estado|progreso|reescanear|buscar|comprobar|logs|_*) ;;
  *)
    no_conozco "el comando" "$1" "${COMANDOS[@]}"
    uso
    ;;
esac

if [ ! -f "$CONF" ]; then
  echo "Falta la configuración: $CONF"
  echo "Cópiala desde config.example y edítala."
  exit 1
fi
# shellcheck source=/dev/null
source "$CONF"

: "${SERVIDOR:?Falta SERVIDOR en $CONF}"
: "${USUARIO_SSH:?Falta USUARIO_SSH en $CONF}"
: "${RUTA_MEDIOS:?Falta RUTA_MEDIOS en $CONF}"
: "${PUNTO_MONTAJE:=$HOME/media-bridge}"
: "${DB_DLNA:=$HOME/.cache/media-bridge}"
: "${DLNA:=si}"
: "${NOMBRE_DLNA:=media-bridge}"
: "${PUERTO_DLNA:=8200}"
: "${REENVIOS:=}"
: "${INTERFAZ:=}"
: "${EXTENSIONES:=mkv mp4 avi m4v mov wmv mpg mpeg ts webm}"
: "${REESCANEO_SEGUNDOS:=3600}"
: "${REENVIOS_SOLO_LAN:=no}"
: "${CLAVE_SSH:=}"
: "${PUERTO_JELLYFIN:=8096}"
: "${DESCUBRIMIENTO_JELLYFIN:=si}"
: "${RECIENTES:=no}"
: "${RECIENTES_CANTIDAD:=10}"
if [ -z "${CARPETAS+x}" ] || [ "${#CARPETAS[@]}" -eq 0 ] || [ -z "${CARPETAS[0]}" ]; then
  echo "Falta CARPETAS en $CONF"
  exit 1
fi
if ! [[ "$REESCANEO_SEGUNDOS" =~ ^[0-9]+$ ]]; then
  echo "REESCANEO_SEGUNDOS tiene que ser un número de segundos (0 para desactivarlo)"
  exit 1
fi
for v in DLNA REENVIOS_SOLO_LAN DESCUBRIMIENTO_JELLYFIN RECIENTES; do
  if [ "${!v}" != si ] && [ "${!v}" != no ]; then
    echo "$v tiene que ser si o no"
    exit 1
  fi
done
for p in ${DLNA:+${PUERTO_DLNA:-}} ${PUERTO_JELLYFIN:-} $REENVIOS; do
  if ! [[ "$p" =~ ^[0-9]+$ ]] || [ "$p" -lt 1 ] || [ "$p" -gt 65535 ]; then
    echo "Puerto no válido en $CONF: $p"
    exit 1
  fi
done
if ! [[ "$RECIENTES_CANTIDAD" =~ ^[1-9][0-9]*$ ]]; then
  echo "RECIENTES_CANTIDAD tiene que ser un número mayor que 0"
  exit 1
fi
if [ -z "${RECIENTES_CARPETAS+x}" ] || [ "${#RECIENTES_CARPETAS[@]}" -eq 0 ] || [ -z "${RECIENTES_CARPETAS[0]}" ]; then
  RECIENTES_CARPETAS=("${CARPETAS[@]}")
fi
for r in "${RECIENTES_CARPETAS[@]}"; do
  encontrada=no
  for c in "${CARPETAS[@]}"; do
    [ "$r" = "$c" ] && encontrada=si
  done
  if [ "$encontrada" = no ]; then
    echo "RECIENTES_CARPETAS incluye \"$r\", que no está en CARPETAS"
    exit 1
  fi
done
HUELLA="$DB_DLNA/huella-lista"
DIR_RECIENTES="$DB_DLNA/Añadidos recientemente"
OPCIONES_CLAVE=()
if [ -n "$CLAVE_SSH" ]; then
  OPCIONES_CLAVE=(-o "IdentityFile=$CLAVE_SSH" -o IdentitiesOnly=yes)
fi

interfaz() {
  if [ -n "$INTERFAZ" ]; then
    echo "$INTERFAZ"
  else
    ip route show default | awk '{print $5; exit}'
  fi
}

ip_local() {
  ip -4 -br addr show "$(interfaz)" 2>/dev/null | awk '{print $3}' | cut -d/ -f1
}

ssh_servidor() {
  ssh -o BatchMode=yes -o ConnectTimeout=8 "${OPCIONES_CLAVE[@]}" "$USUARIO_SSH@$SERVIDOR" "$@"
}

reenviar_solo_lan() {
  local p=$1 ip pid=""
  trap '[ -n "$pid" ] && kill "$pid" 2>/dev/null; exit 0' TERM INT
  while :; do
    ip=$(ip_local)
    if [ -n "$ip" ]; then
      echo "Reenviando el puerto $p solo en $ip"
      socat "TCP-LISTEN:$p,fork,reuseaddr,bind=$ip" "TCP:$SERVIDOR:$p" &
      pid=$!
    else
      echo "Sin IP en la red local; espero a tenerla para reenviar el puerto $p"
    fi
    while :; do
      sleep 10 &
      wait $!
      [ "$(ip_local)" = "$ip" ] || break
      [ -z "$pid" ] || kill -0 "$pid" 2>/dev/null || break
    done
    if [ -n "$pid" ]; then
      kill "$pid" 2>/dev/null
      wait "$pid" 2>/dev/null
      pid=""
    fi
  done
}

contar() {
  curl -s --max-time 5 "http://127.0.0.1:$PUERTO_DLNA/" | grep -oE 'Video files</td><td>[0-9]+' | grep -oE '[0-9]+$'
}

reproduciendo() {
  ss -Htn state established "( sport = :$PUERTO_DLNA )" | grep -v 127.0.0.1 | grep -q .
}

en_docker() {
  [ "${MEDIA_BRIDGE_DOCKER:-}" = 1 ]
}

dlna_activo() {
  if en_docker; then
    pgrep -x minidlnad >/dev/null
  else
    systemctl --user -q is-active media-bridge-dlna.service
  fi
}

descubrimiento_previsto() {
  [ "$DESCUBRIMIENTO_JELLYFIN" = si ] && [[ " $REENVIOS " == *" $PUERTO_JELLYFIN "* ]]
}

descubrimiento_activo() {
  if en_docker; then
    pgrep -f "descubrimiento.py" >/dev/null
  else
    systemctl --user -q is-active media-bridge-descubrimiento.service
  fi
}

texto_descubrimiento() {
  if descubrimiento_activo; then
    echo "Jellyfin: las apps de la red local lo encuentran solas (descubrimiento en 7359/udp)"
  fi
}

reiniciar_dlna() {
  if en_docker; then
    kill -USR1 1
  else
    systemctl --user restart media-bridge-dlna.service
  fi
}

buscar_en_servidor() {
  local formato=$1 carpetas="" filtro="" impresion="" c e
  shift
  for c in "$@"; do
    carpetas+=" $(printf '%q' "$c")"
  done
  for e in $EXTENSIONES; do
    filtro+="${filtro:+ -o} -iname '*.$e'"
  done
  if [ -n "$formato" ]; then
    impresion=" -printf $(printf '%q' "$formato")"
  fi
  ssh_servidor "cd $(printf '%q' "$RUTA_MEDIOS") && find$carpetas \\( -type f -o -type l \\) \\( $filtro \\)$impresion"
}

listar_videos() {
  buscar_en_servidor "" "${CARPETAS[@]}"
}

actualizar_recientes() {
  local lista
  [ "$RECIENTES" = si ] || return 0
  mkdir -p "$DIR_RECIENTES"
  if ! lista=$(buscar_en_servidor '%T@\t%p\n' "${RECIENTES_CARPETAS[@]}"); then
    echo "No llego al servidor; dejo Añadidos recientemente como estaba"
    return 0
  fi
  printf '%s\n' "$lista" | python3 "$SHARE/recientes.py" \
    --llegadas "$DB_DLNA/llegadas" \
    --destino "$DIR_RECIENTES" \
    --montaje "$PUNTO_MONTAJE" \
    --cantidad "$RECIENTES_CANTIDAD"
}

texto_recientes() {
  if [ "$RECIENTES" = si ]; then
    local lista
    lista=$(printf '%s, ' "${RECIENTES_CARPETAS[@]}")
    echo "Recientes: los $RECIENTES_CANTIDAD últimos de ${lista%, }"
  fi
}

directorios_dlna() {
  local c
  if [ "$RECIENTES" = si ]; then
    echo "media_dir=V,$DIR_RECIENTES"
  fi
  for c in "${CARPETAS[@]}"; do
    echo "media_dir=V,$PUNTO_MONTAJE/$c"
  done
}

huella_lista() {
  local lista
  lista=$(listar_videos) || return 1
  printf '%s\n' "$lista" | LC_ALL=C sort | sha256sum | cut -d' ' -f1
}

texto_reescaneo() {
  if [ "$REESCANEO_SEGUNDOS" -gt 0 ]; then
    echo "Reescaneo: cada $REESCANEO_SEGUNDOS s, solo si hay cambios"
  else
    echo "Reescaneo: automático desactivado"
  fi
}

aparatos_dlna() {
  local propia=$1 n tipo ip_aparato abiertas
  curl -s --max-time 5 "http://127.0.0.1:$PUERTO_DLNA/" \
    | sed 's/<tr>/\n<tr>/g' \
    | sed -nE 's#^<tr><td>([0-9]+)</td><td>([^<]*)</td><td>([^<]*)</td><td>[^<]*</td><td>([0-9]+)</td>.*#\1|\2|\3|\4#p' \
    | while IFS='|' read -r n tipo ip_aparato abiertas; do
        [ "$ip_aparato" = 127.0.0.1 ] && continue
        [ "$ip_aparato" = "$propia" ] && continue
        if [ "$abiertas" -gt 0 ]; then
          echo "          $ip_aparato ($tipo), conectado ahora"
        else
          echo "          $ip_aparato ($tipo)"
        fi
      done
}

texto_aparatos() {
  local lista
  lista=$(aparatos_dlna "$1")
  if [ -n "$lista" ]; then
    echo "Aparatos que han encontrado el DLNA:"
    echo "$lista"
  else
    echo "Ningún aparato ha encontrado todavía el DLNA"
  fi
}

estado_docker() {
  local ip p
  ip=$(ip_local)
  if mountpoint -q "$PUNTO_MONTAJE"; then echo "Montaje:  activo"; else echo "Montaje:  caído"; fi
  for p in $REENVIOS; do
    if pgrep -f "socat TCP-LISTEN:$p," >/dev/null; then
      echo "Reenvío:  http://$ip:$p"
    fi
  done
  texto_descubrimiento
  if dlna_activo; then
    echo "DLNA:     $NOMBRE_DLNA"
    texto_recientes
    texto_reescaneo
    texto_aparatos "$ip"
  fi
}

estado() {
  if en_docker; then
    estado_docker
    return
  fi
  local u
  for u in $(systemctl --user list-units --all --plain --no-legend 'media-bridge-*' | awk '{print $1}'); do
    printf "%-34s %s\n" "$u" "$(systemctl --user is-active "$u")"
  done
  local ip p
  ip=$(ip_local)
  for p in $REENVIOS; do
    if systemctl --user -q is-active "media-bridge-forward@$p.service"; then
      echo "Reenvío:  http://$ip:$p"
    fi
  done
  texto_descubrimiento
  if dlna_activo; then
    echo "DLNA:     $NOMBRE_DLNA"
    texto_recientes
    texto_reescaneo
    texto_aparatos "$ip"
  fi
  if ! systemctl --user list-units --state=active --plain --no-legend 'media-bridge-*' | grep -q .; then
    echo "Todo apagado. Enciéndelo con: medios on"
  fi
}

generar_conf_dlna() {
  local conf="$DB_DLNA/minidlna.conf"
  mkdir -p "$DB_DLNA"
  {
    echo "friendly_name=$NOMBRE_DLNA"
    directorios_dlna
    echo "db_dir=$DB_DLNA"
    echo "log_dir=$DB_DLNA"
    echo "port=$PUERTO_DLNA"
    echo "network_interface=$(interfaz)"
    echo "inotify=no"
    echo "notify_interval=60"
    echo "root_container=B"
    echo "strict_dlna=no"
  } > "$conf"
  echo "$conf"
}

FORZAR=no
QR=no

leer_opciones() {
  local comando=$1 o validas=(-j --jellyfin)
  shift
  [ "$comando" = on ] && validas+=(--forzar)
  for o in "$@"; do
    if [ "$o" = -j ] || [ "$o" = --jellyfin ]; then
      QR=si
    elif [ "$o" = --forzar ] && [ "$comando" = on ]; then
      FORZAR=si
    else
      no_conozco "la opción" "$o" "${validas[@]}"
      echo
      ayuda_comando "$comando"
      exit 1
    fi
  done
}

reenvio_activo() {
  if en_docker; then
    pgrep -f "socat TCP-LISTEN:$1," >/dev/null
  else
    systemctl --user -q is-active "media-bridge-forward@$1.service"
  fi
}

mostrar_qr() {
  local url
  if ! [[ " $REENVIOS " == *" $PUERTO_JELLYFIN "* ]]; then
    echo
    echo "Jellyfin (puerto $PUERTO_JELLYFIN) no está en REENVIOS, así que no hay dirección que enseñar"
    return
  fi
  if ! reenvio_activo "$PUERTO_JELLYFIN"; then
    echo
    echo "El reenvío de Jellyfin no está encendido. Enciéndelo con: medios on"
    return
  fi
  url="http://$(ip_local):$PUERTO_JELLYFIN"
  echo
  echo "Jellyfin: $url"
  asegurar_qrencode || return
  qrencode -t ANSIUTF8 -m 2 "$url"
}

asegurar_qrencode() {
  command -v qrencode >/dev/null && return 0
  echo
  echo "Para el código QR hace falta qrencode y no está instalado."
  if en_docker; then
    echo "Lo descargo ahora dentro del contenedor (solo esta vez)..."
    apk add --no-cache -q libqrencode-tools >/dev/null
  elif [ ! -t 0 ]; then
    echo "No puedo pedirte la contraseña de sudo desde aquí. Instálalo a mano (paquete qrencode) y vuelve a probar."
    return 1
  elif command -v pacman >/dev/null; then
    echo "Lo descargo e instalo ahora (solo esta vez). Te pedirá la contraseña de sudo:"
    sudo pacman -S --needed --noconfirm qrencode
  elif command -v apt-get >/dev/null; then
    echo "Lo descargo e instalo ahora (solo esta vez). Te pedirá la contraseña de sudo:"
    sudo apt-get install -y qrencode
  elif command -v dnf >/dev/null; then
    echo "Lo descargo e instalo ahora (solo esta vez). Te pedirá la contraseña de sudo:"
    sudo dnf install -y qrencode
  else
    echo "No sé instalarlo en este sistema. Instala el paquete qrencode a mano y vuelve a probar."
    return 1
  fi
  if ! command -v qrencode >/dev/null; then
    echo "No se pudo instalar qrencode. Puedes abrir la dirección de arriba escribiéndola en el móvil."
    return 1
  fi
  echo "qrencode instalado; las próximas veces el QR sale directamente."
  echo
}

ERRORES=0

bien() { echo "  ✔ $*"; }
mal() { echo "  ✘ $*"; ERRORES=$((ERRORES + 1)); }
aviso() { echo "  ! $*"; }

carpetas_que_faltan() {
  local lista="" c
  for c in "${CARPETAS[@]}"; do
    lista+=" $(printf '%q' "$c")"
  done
  ssh_servidor "cd $(printf '%q' "$RUTA_MEDIOS") 2>/dev/null || { echo $(printf '%q' "$RUTA_MEDIOS"); exit 0; }; for c in$lista; do [ -d \"\$c\" ] || echo \"\$c\"; done"
}

comprobar_red() {
  local iface ip gw sonda d
  iface=$(interfaz)
  ip=$(ip_local)
  if [ -z "$iface" ] || [ -z "$ip" ]; then
    mal "No encuentro la red local (interfaz \"${iface:-ninguna}\" sin IP). Revisa la conexión o INTERFAZ en la configuración"
    return
  fi
  bien "Red local: $ip en $iface"
  gw=$(ip route show default | awk '{print $3; exit}')
  sonda="${ip%.*}.254"
  [ "$sonda" = "$ip" ] && sonda="${ip%.*}.253"
  for d in $gw $sonda; do
    if ip route get "$d" 2>/dev/null | grep -q "dev tailscale0"; then
      mal "La red local sale por Tailscale: el equipo contestaría a la televisión por el túnel. Suele arreglarse con: sudo tailscale set --accept-routes=false"
      return
    fi
  done
  bien "La red local no pasa por Tailscale"
}

comprobar_servidor() {
  local faltan p
  if ! ssh_servidor true 2>/dev/null; then
    if command -v tailscale >/dev/null && ! tailscale status >/dev/null 2>&1; then
      mal "Tailscale no está conectado en este equipo"
    else
      mal "No puedo entrar por SSH a $USUARIO_SSH@$SERVIDOR: servidor apagado, sin clave SSH o SERVIDOR equivocado"
    fi
    return
  fi
  bien "SSH a $USUARIO_SSH@$SERVIDOR"
  faltan=$(carpetas_que_faltan)
  if [ -n "$faltan" ]; then
    mal "En el servidor no existen: $(printf '%s' "$faltan" | paste -sd, - | sed 's/,/, /g')"
  else
    bien "Carpetas en el servidor: ${#CARPETAS[@]}"
  fi
  for p in $REENVIOS; do
    if ! socat /dev/null "TCP:$SERVIDOR:$p,connect-timeout=3" 2>/dev/null; then
      aviso "El servidor no responde en el puerto $p ($SERVIDOR:$p): revisa que el servicio esté encendido y escuche en Tailscale"
    fi
  done
}

comprobar_puerto() {
  local p=$1
  if ss -Hltn "( sport = :$p )" | grep -q .; then
    if [ "$p" = "$PUERTO_DLNA" ] && ! en_docker && systemctl -q is-active minidlna.service 2>/dev/null; then
      mal "El puerto $p lo usa el minidlna del sistema. Desactívalo con: sudo systemctl disable --now minidlna.service"
    else
      mal "El puerto $p ya lo usa otro programa"
    fi
    return 1
  fi
  return 0
}

comprobar_puertos() {
  local p libres=""
  for p in $REENVIOS; do
    reenvio_activo "$p" && continue
    comprobar_puerto "$p" && libres+=" $p"
  done
  if [ "$DLNA" = si ] && ! dlna_activo; then
    comprobar_puerto "$PUERTO_DLNA" && libres+=" $PUERTO_DLNA"
  fi
  if descubrimiento_previsto && ! descubrimiento_activo; then
    if ss -Hlun "( sport = :7359 )" | grep -q .; then
      mal "El puerto 7359/udp del descubrimiento de Jellyfin ya lo usa otro programa (¿un Jellyfin en este equipo?). Libéralo o pon DESCUBRIMIENTO_JELLYFIN=no"
    else
      libres+=" 7359/udp"
    fi
  fi
  [ -n "$libres" ] && bien "Puertos libres:$libres"
  return 0
}

comprobar_firewall() {
  local p puertos="$REENVIOS" cerrados=""
  en_docker && return
  systemctl -q is-active ufw 2>/dev/null || return
  [ -r /etc/ufw/user.rules ] || return
  [ "$DLNA" = si ] && puertos+=" $PUERTO_DLNA 1900"
  descubrimiento_previsto && puertos+=" 7359"
  for p in $puertos; do
    grep -v -- '-i tailscale0' /etc/ufw/user.rules | grep -qE -- "--dport $p( |$).*-j ACCEPT" || cerrados+="${cerrados:+, }$p"
  done
  if [ -n "$cerrados" ]; then
    aviso "ufw está activo y no abre: $cerrados. La televisión no llegará; ábrelos con ./install.sh --firewall"
  fi
}

comprobar_indice() {
  local conf="$DB_DLNA/minidlna.conf" antes ahora
  [ "$DLNA" = si ] || return
  [ -f "$DB_DLNA/files.db" ] && [ -f "$conf" ] || return
  dlna_activo && return
  antes=$(grep '^media_dir=' "$conf")
  ahora=$(directorios_dlna)
  if [ "$antes" != "$ahora" ]; then
    aviso "Has cambiado CARPETAS o RECIENTES: el DLNA va a indexar todo de nuevo. Sigue el avance con: medios progreso"
  fi
}

comprobar() {
  local modo=${1:-on}
  ERRORES=0
  if [ "$modo" = on ]; then
    echo "Comprobando antes de encender:"
  else
    echo "Comprobando:"
  fi
  comprobar_red
  comprobar_servidor
  comprobar_puertos
  comprobar_firewall
  comprobar_indice
  if [ "$ERRORES" -gt 0 ]; then
    if [ "$modo" = on ]; then
      echo "No enciendo nada hasta que se corrija lo marcado con ✘ (o fuerza con: medios on --forzar)"
    else
      echo "Lo marcado con ✘ impediría encender con medios on"
    fi
    echo "Pistas para arreglarlo: medios ayuda problemas"
    return 1
  fi
  if [ "$modo" = on ]; then
    echo
  else
    echo "Todo en orden"
  fi
  return 0
}

case "${1:-estado}" in
  on|off)
    if en_docker; then
      echo "En Docker se enciende y se apaga con: docker compose up -d / docker compose down"
      exit 1
    fi
    ;;&
  on)
    leer_opciones "${1:-estado}" "${@:2}"
    if [ "$FORZAR" != si ]; then
      comprobar || exit 1
    fi
    if [ "$DLNA" = si ]; then
      systemctl --user start media-bridge-mount.service media-bridge-dlna.service
      if [ "$REESCANEO_SEGUNDOS" -gt 0 ]; then
        systemctl --user start media-bridge-rescan.service
      fi
    fi
    for p in $REENVIOS; do
      systemctl --user start "media-bridge-forward@$p.service"
    done
    if descubrimiento_previsto; then
      systemctl --user start media-bridge-descubrimiento.service
    fi
    sleep 3
    estado
    if [ "$QR" = si ]; then
      mostrar_qr
    fi
    ;;
  off)
    systemctl --user stop 'media-bridge-*'
    estado
    ;;
  estado)
    leer_opciones "${1:-estado}" "${@:2}"
    estado
    if [ "$QR" = si ]; then
      mostrar_qr
    fi
    ;;
  logs)
    if en_docker; then
      echo "En Docker los registros se ven desde fuera con: docker compose logs -f"
      exit 1
    fi
    shift
    unidades=()
    seguir=()
    for o in "$@"; do
      case "$o" in
        -f|--seguir) seguir=(-f) ;;
        montaje) unidades+=(-u media-bridge-mount.service) ;;
        dlna) unidades+=(-u media-bridge-dlna.service) ;;
        reenvios|reenvíos) unidades+=(-u 'media-bridge-forward@*') ;;
        reescaneo) unidades+=(-u media-bridge-rescan.service) ;;
        descubrimiento) unidades+=(-u media-bridge-descubrimiento.service) ;;
        *)
          no_conozco "la parte" "$o" montaje dlna reenvios reescaneo descubrimiento -f
          echo
          ayuda_comando logs
          exit 1
          ;;
      esac
    done
    [ ${#unidades[@]} -gt 0 ] || unidades=(-u 'media-bridge-*')
    exec journalctl --user "${unidades[@]}" -n 50 --no-pager -o short "${seguir[@]}"
    ;;
  buscar)
    shift
    [ $# -gt 0 ] || uso
    listar_videos | python3 "$SHARE/buscar.py" "$@"
    ;;
  progreso)
    if ! dlna_activo; then
      echo "El DLNA está apagado; enciéndelo con: medios on"
      exit 1
    fi
    total=$(listar_videos | wc -l)
    if [ "$RECIENTES" = si ] && [ -d "$DIR_RECIENTES" ]; then
      total=$(( total + $(find "$DIR_RECIENTES" -maxdepth 1 -type l | wc -l) ))
    fi
    inicio=$(date +%s)
    n0=$(contar)
    n0=${n0:-0}
    echo "Ctrl+C para salir"
    while :; do
      n=$(contar)
      n=${n:-0}
      t=$(( $(date +%s) - inicio ))
      ritmo=""
      resto=""
      if [ "$t" -ge 10 ] && [ "$n" -gt "$n0" ]; then
        v=$(( (n - n0) * 60 / t ))
        ritmo="  ${v}/min"
        if [ "$v" -gt 0 ] && [ "$total" -gt "$n" ]; then
          resto="  ~$(( (total - n + v - 1) / v )) min"
        fi
      fi
      if [ "$(pgrep -c -u "$(id -u)" minidlnad)" -le 1 ]; then
        printf "\r\033[K%s de %s vídeos  terminado\n" "$n" "$total"
        exit 0
      fi
      pct=$(( total > 0 ? n * 100 / total : 0 ))
      printf "\r\033[K%s de %s vídeos (%s%%)%s%s" "$n" "$total" "$pct" "$ritmo" "$resto"
      sleep 2
    done
    ;;
  reescanear)
    if ! dlna_activo; then
      echo "El DLNA está apagado; enciéndelo con: medios on"
      exit 1
    fi
    antes=$(contar)
    if reproduciendo; then
      echo "Aviso: se corta lo que se esté viendo"
    fi
    reiniciar_dlna
    echo "Reescaneando (antes: ${antes:-?} vídeos)..."
    sleep 20
    echo "Ahora: $(contar) vídeos (si hay muchos nuevos, sigue sumando un rato)"
    ;;
  comprobar)
    comprobar solo
    exit
    ;;
  _comprobar)
    comprobar
    exit
    ;;
  _montar)
    mkdir -p "$PUNTO_MONTAJE"
    fusermount3 -uz "$PUNTO_MONTAJE" 2>/dev/null
    exec sshfs -f "${OPCIONES_CLAVE[@]}" \
      -o ro,follow_symlinks,reconnect,ServerAliveInterval=15,ServerAliveCountMax=3,BatchMode=yes,kernel_cache,max_conns=4 \
      "$USUARIO_SSH@$SERVIDOR:$RUTA_MEDIOS" "$PUNTO_MONTAJE"
    ;;
  _desmontar)
    fusermount3 -u "$PUNTO_MONTAJE"
    ;;
  _esperar-montaje)
    for _ in $(seq 30); do
      if mountpoint -q "$PUNTO_MONTAJE" && ls "$PUNTO_MONTAJE/${CARPETAS[0]}" >/dev/null 2>&1; then
        exit 0
      fi
      sleep 2
    done
    echo "El montaje de $PUNTO_MONTAJE no responde"
    exit 1
    ;;
  _dlna)
    conf=$(generar_conf_dlna)
    actualizar_recientes
    if ! huella_lista > "$HUELLA.tmp" 2>/dev/null; then
      rm -f "$HUELLA.tmp"
    else
      mv "$HUELLA.tmp" "$HUELLA"
    fi
    exec minidlnad -S -r -f "$conf" -P "${XDG_RUNTIME_DIR:-/tmp}/media-bridge-dlna.pid"
    ;;
  _reenviar)
    [ -n "${2:-}" ] || exit 1
    if [ "$REENVIOS_SOLO_LAN" = si ]; then
      reenviar_solo_lan "$2"
    fi
    exec socat "TCP-LISTEN:$2,fork,reuseaddr" "TCP:$SERVIDOR:$2"
    ;;
  _descubrimiento)
    exec python3 -u "$SHARE/descubrimiento.py" \
      --info "http://$SERVIDOR:$PUERTO_JELLYFIN/System/Info/Public" \
      --puerto-jellyfin "$PUERTO_JELLYFIN"
    ;;
  _vigilar)
    if [ "$REESCANEO_SEGUNDOS" -eq 0 ]; then
      echo "Reescaneo automático desactivado"
      exit 0
    fi
    echo "Busco cambios en el servidor cada $REESCANEO_SEGUNDOS s"
    while sleep "$REESCANEO_SEGUNDOS"; do
      if ! nueva=$(huella_lista); then
        echo "No llego al servidor; lo intento en la próxima vuelta"
        continue
      fi
      vieja=$(cat "$HUELLA" 2>/dev/null)
      if [ -z "$vieja" ]; then
        echo "$nueva" > "$HUELLA"
        continue
      fi
      [ "$nueva" = "$vieja" ] && continue
      if reproduciendo; then
        echo "Hay vídeos nuevos o borrados, pero se está viendo algo; espero a la próxima vuelta"
        continue
      fi
      echo "Hay vídeos nuevos o borrados; reescaneo"
      reiniciar_dlna
    done
    ;;
  *)
    uso
    ;;
esac
